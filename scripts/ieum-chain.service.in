[Unit]
Description=IEUM Chain Node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_GROUP@
WorkingDirectory=@INSTALL_DIR@
ExecStart=@INSTALL_DIR@/ieum-chain server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
